    "dotenv": "^18.0.8",
    "handlebars": "^4.7.10",
    "hono": "^4.13.13",
    "openid-client": "^6.8.8",
    "qs": "^6.16.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@tsconfig/node22": "latest",
    "@types/jest": "^30.0.0",
    "@types/node": "^26",
    "@types/qs": "^6.14.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-junit": "^17.0.0",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "eslint-config-prettier": "^10.1.8",
    "typescript-eslint": "^8.72.0"
